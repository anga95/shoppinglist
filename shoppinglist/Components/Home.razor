@page "/"
@using Shoppinglist.Core.Events
@inject Shoppinglist.Core.ViewModels.HomeViewModel VM
@inject AppEvents Events

<h3>Inköpslista</h3>

<div style="display:flex;gap:.5rem;align-items:center">
    <input @bind="VM.NewName" @bind:event="oninput" placeholder="Lägg till vara..." />
    <button class="btn btn-primary" @onclick="VM.AddAsync" disabled="@string.IsNullOrWhiteSpace(VM.NewName)">Lägg till</button>
    <span>@VM.Status</span>
</div>

<ul class="shopping-list">
    @foreach (var item in VM.Items)
    {
        <li>
            <div class="item-row">
                <input type="checkbox"
                       @bind="item.IsChecked"
                       @bind:after="async () => await VM.ToggleAsync(item)" />
                <span class="@(item.IsChecked ? "checked" : null)">@item.Name</span>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => VM.DeleteAsync(item.Id)">x</button>
            </div>
        </li>
    }
</ul>

@code {

    protected override async Task OnInitializedAsync()
    {
        VM.Changed += OnVmChanged;
        await VM.InitializeAsync();
    }

    private void OnVmChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => VM.Changed -= OnVmChanged;
}