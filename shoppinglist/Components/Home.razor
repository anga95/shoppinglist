@page "/"
@using Shoppinglist.Core.Events
@inject Shoppinglist.Core.ViewModels.HomeViewModel VM
@inject IAppEvents Events

<h3>Inköpslista</h3>

<div class="d-flex flex-column gap-2 mb-2">
    <div class="d-flex gap-2 align-items-stretch">
        <input class="form-control"
               @bind="VM.NewName"
               @bind:event="oninput"
               placeholder="Lägg till vara..."/>

        <button class="btn btn-primary"
                @onclick="VM.AddAsync"
                disabled="@string.IsNullOrWhiteSpace(VM.NewName)">
            Lägg till
        </button>    
    </div>

    <div class="status-slot">
        @if (!string.IsNullOrWhiteSpace(VM.Status))
        {
            <div class="text-muted small">
                @VM.Status
            </div>
        }    
    </div>
    
</div>

<ul class="shopping-list">
    @foreach (var item in VM.Items)
    {
        <li>
            <div class="item-row">
                <input type="checkbox"
                       @bind="item.IsChecked"
                       @bind:after="async () => await VM.ToggleAsync(item)" />
                <span class="@(item.IsChecked ? "checked" : null)">@item.Name</span>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => VM.DeleteAsync(item.Id)">x</button>
            </div>
        </li>
    }
</ul>

@code {

    protected override async Task OnInitializedAsync()
    {
        VM.Changed += OnVmChanged;
        await VM.InitializeAsync();
    }

    private void OnVmChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => VM.Changed -= OnVmChanged;
}
