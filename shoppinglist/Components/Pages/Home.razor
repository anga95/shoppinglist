@page "/"

<h1>Hello, world!</h1>

<p>Welcome to your new app.</p>

<button class="btn btn-primary" @onclick="OnButtonClick">Klicka mig</button>

@if (!string.IsNullOrEmpty(message))
{
    <p class="text-success">@message</p>
}

@code {
    private string message;

    private void OnButtonClick()
    {
        message = $"Knappen trycktes! ({DateTime.Now:HH:mm:ss})";
    }
}