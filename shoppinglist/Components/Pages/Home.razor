    <span>@status</span>
</div>

<ul>
    @foreach (var it in items)
    {
        <li style="display:flex;align-items:center;gap:.5rem">
            <input type="checkbox"
                   @bind="it.IsChecked"
                   @bind:after="async () => await Service.SetCheckedAsync(it.Id, it.IsChecked)" />
            <span>@it.Name</span>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(it.Id)">x</button>
        </li>
    }
</ul>

@code {
    private List<Item> items = new();
    private string newName = "";
    private string status = "";

    protected override async Task OnInitializedAsync()
        => items = await Service.GetAllAsync();

    private async Task AddAsync()
    {
        var added = await Service.AddAsync(newName);
        status = added is null ? "Tomt eller dubblett." : $"Lade till '{added.Name}'.";
        if (added is not null) newName = "";
        items = await Service.GetAllAsync();
        StateHasChanged();
    }

    private async Task DeleteAsync(int id)
    {
        await Service.DeleteAsync(id);
        items = await Service.GetAllAsync();
        StateHasChanged();
    }
