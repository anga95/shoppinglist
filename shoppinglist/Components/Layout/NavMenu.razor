@inject Shoppinglist.Core.ViewModels.HomeViewModel VM

<div class="topbar">
    <!-- row 1 -->
    <div class="row1">
        <div class="left"><RecipesMenu /></div>
        <div class="title">Inköp</div>
        <div style="width: 40px"> </div> <!-- placeholder for right side -->
    </div>
    <!-- row 2 -->
    <div class="row2">
        <input class="top-input"
               @bind="VM.NewName"
               @bind:event="oninput"
               placeholder="Lägg till vara..."
               autocorrect="off" 
               autocapitalize="off" 
               spellcheck="false"
               enterkeyhint="done"
               @onkeydown="HandleKey"/>
    </div>
</div>

@code {
    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(VM.NewName))
        {
            await VM.AddAsync();
        }
    }
}