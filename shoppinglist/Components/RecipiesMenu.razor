@using shoppinglist.Components.ViewModels
@inject RecipiesMenuViewModel VM

<button class="btn btn-outline-light" @onclick="VM.ToggleMenu">Recept ▼</button>

@if (VM.Open)
{
    <div class="rec-backdrop" @onclick="VM.CloseMenu"></div>
    <div class="rec-menu" @onclick:stopPropagation="true">
        @if (VM.Recipies.Count == 0)
        {
            <div class="p-2 text-muted">Inga recept ännu</div>
        }
        else
        {
            @foreach (var r in VM.Recipies)
            {
                <div class="rec-item">
                    <div class="rec-head" @onclick="() => VM.ToggleRec(r.Id)">
                        <span>@r.Title</span>
                        <span>@(VM.Expanded.Contains(r.Id) ? "▲" : "▼")</span>
                    </div>

                    @if (VM.Expanded.Contains(r.Id))
                    {
                        var items = RecipiesMenuViewModel.OrderForDisplay(r.RecipieItems.Select(ri => ri.Item));
                        <ul class="rec-ingredients">
                            @foreach (var it in items)
                            {
                                <li @key="it.Id">
                                    <input type="checkbox"
                                           @bind="@it.IsChecked"
                                           @bind:after="async () =>  await VM.SetIngredientCheckedAsync(it)"/>
                                    <span class="@(it.IsChecked ? "text-muted" : null)">@it.Name</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        }
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        VM.Changed += OnChanged;
        await VM.InitAsync();
    }
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => VM.Changed -= OnChanged;
}

